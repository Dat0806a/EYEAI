{
  "name": "y-te-cho-nguoi-binh-thuong-backend",
  "version": "1.0.0",
  "description": "Backend API for medical report OCR and AI explanation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --ci",
    "test:watch": "jest --watch",
    "test:contract": "jest --ci tests/contract.test.ts",
    "verify:media": "ts-node --transpile-only scripts/verify-media-catalog.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.10",
    "multer": "^2.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.3"
  }
