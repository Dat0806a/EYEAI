{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatbotMessage",
  "type": "object",
  "required": ["sessionId", "reply"],
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "reply": {
      "type": "string"
    },
    "audioUrl": {
      "type": ["string", "null"]
    }
  }
}
