{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OAuthSession",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "token", "intent"],
  "properties": {
    "userId": { "type": "string", "format": "uuid" },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^\\S+$"
    },
    "intent": { "type": "string", "enum": ["LOGIN", "REGISTER", "LINK"] }
  }
}
