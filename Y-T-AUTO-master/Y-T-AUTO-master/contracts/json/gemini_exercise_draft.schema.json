{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeminiExerciseDraft",
  "description": "Internal structured output accepted from Gemini before trusted YouTube fields are attached.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "items"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "duration", "difficulty", "rationale"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "difficulty": {
            "type": "string",
            "enum": ["EASY", "MEDIUM", "HARD"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
