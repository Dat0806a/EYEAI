{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthSession",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "token"],
  "properties": {
    "userId": { "type": "string", "format": "uuid" },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^\\S+$"
    }
  }
}
