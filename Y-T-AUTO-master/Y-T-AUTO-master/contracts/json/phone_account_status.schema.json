{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhoneAccountStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["phoneVerified", "maskedPhone"],
  "properties": {
    "phoneVerified": { "type": "boolean" },
    "maskedPhone": {
      "type": ["string", "null"],
      "pattern": "^\\+[1-9][0-9]{0,2}\\*{4,12}[0-9]{2,4}$"
    }
  },
  "oneOf": [
    {
      "properties": {
        "phoneVerified": { "const": false },
        "maskedPhone": { "type": "null" }
      }
    },
    {
      "properties": {
        "phoneVerified": { "const": true },
        "maskedPhone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{0,2}\\*{4,12}[0-9]{2,4}$"
        }
      }
    }
  ]
}
