{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReportDetail",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "overallSummary", "results", "mealPlan", "exercisePlan"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "overallSummary": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_code",
          "test_name",
          "value",
          "unit",
          "reference_low",
          "reference_high",
          "reference_text",
          "status",
          "ocr_confidence",
          "explanation"
        ],
        "properties": {
          "test_code": { "type": "string", "minLength": 1 },
          "test_name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "reference_low": { "type": ["number", "null"] },
          "reference_high": { "type": ["number", "null"] },
          "reference_text": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["LOW", "NORMAL", "HIGH", "UNKNOWN"] },
          "ocr_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "explanation": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "mealPlan": {
      "oneOf": [
        { "$ref": "meal_plan.schema.json" },
        { "type": "null" }
      ]
    },
    "exercisePlan": {
      "oneOf": [
        { "$ref": "exercise_plan.schema.json" },
        { "type": "null" }
      ]
    }
  }
}
