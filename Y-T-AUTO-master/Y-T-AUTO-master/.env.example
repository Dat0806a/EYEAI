# ============================================================
# Y Tế Cho Người Bình Thường - Environment Variables
# Copy file này thành .env và điền giá trị phù hợp.
# KHÔNG commit file .env thật vào repository.
# ============================================================

# Backend server
# Cổng chạy API backend. Mặc định: 5000
PORT=5000

# Đường dẫn tới file database SQLite. Mặc định: ./data/yte.db
DATABASE_PATH=./data/yte.db

# Thư mục lưu ảnh xét nghiệm upload. Mặc định: ./data/uploads
UPLOAD_DIR=./data/uploads

# Giới hạn kích thước file upload (MB). Mặc định: 10
MAX_FILE_SIZE_MB=10

# Secret ký JWT - BẮT BUỘC phải thay trong production bằng giá trị mạnh
JWT_SECRET=change-me-to-a-long-random-string

# Thời gian hết hạn JWT. Mặc định: 7d
JWT_EXPIRES_IN=7d

# Google Gemini API Key (dùng cho OCR/AI thật). Nếu để trống,
# hệ thống dùng provider DEV_FALLBACK (chỉ cho phát triển).
GEMINI_API_KEY=

# URL backend mà frontend gọi (mặc định dùng proxy Vite tới localhost:5000)
# VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth (P1) - để trống sẽ tắt flow Google và trả OAUTH_NOT_CONFIGURED
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
WEB_ORIGIN=http://localhost:5173

# Facebook OAuth (P2)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/auth/facebook/callback

# Phone OTP (P2)
# Chọn chính xác một production adapter: twilio hoặc esms.
# Để trống/từng phần provider đang chọn sẽ tắt phoneOtp và trả OTP_NOT_CONFIGURED.
OTP_SMS_PROVIDER=twilio

# BẮT BUỘC khi bật Phone OTP: secret HMAC riêng, tối thiểu 32 byte UTF-8.
# Không dùng lại JWT_SECRET và không commit giá trị thật.
OTP_HMAC_SECRET=

# BẮT BUỘC khi OTP_SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# BẮT BUỘC chọn chính xác MỘT trong hai sender sau.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Tùy chọn cho Twilio. Timeout phải từ 1-120000 ms.
TWILIO_REQUEST_TIMEOUT_MS=10000

# BẮT BUỘC khi OTP_SMS_PROVIDER=esms. Chỉ dùng placeholder; không commit credential thật.
ESMS_API_KEY=
ESMS_SECRET_KEY=

# Tùy chọn cho eSMS. Endpoint, Brandname=Baotrixemay, SmsType=2 và template OTP
# được cố định trong adapter theo tài liệu chính thức; live handset không dùng Sandbox.
ESMS_REQUEST_TIMEOUT_MS=10000

# Cooldown không dài hơn TTL; attempts từ 1 đến 5.
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
