# Backend Server Secrets (Localhost: configure in .env.local | Netlify: configure in Dashboard Environment Variables)
# NEVER prefix these server-side secrets with VITE_
GEMINI_API_KEY="MY_GEMINI_API_KEY"
PATIENT_AGENT_GEMINI_API_KEY=""
YOUTUBE_API_KEY=""
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS=""

# Client Public Configuration (Embedded into Vite frontend bundle intentionally)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY=""
